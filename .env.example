# Model used for requirement extraction and CV assessment
GROQ_MODEL=openai/gpt-oss-120b
# Upload limits
MAX_FILES=20
MAX_FILE_MB=5
# Parallel LLM calls (lower this if you hit Groq rate limits)
MAX_CONCURRENCY=3
MAX_CV_CHARS=15000
AUDIT_LOG_PATH=audit/screening_log.jsonl
# Used by the Streamlit UI
API_URL=http://localhost:8000
